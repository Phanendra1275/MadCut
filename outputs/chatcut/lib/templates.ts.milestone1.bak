export const packTemplates = packMetadata;
export type TemplateItem = {
  name: Template;
  displayName?: string;
  id?: string;
  label: string;
  sample: string;
  accent: string;
  category?: string;
  preview?: string;
  file?: string;
  defaults?: { entry: string; motion: boolean; color: string; size?: number; position?: number; font?: string }
};

export const templateCatalog: TemplateItem[] = [
  ...existingCatalog.filter(t => !t.label.includes('web recreation')),
  ...packMetadata.map(t => ({ ...t, name: t.webPreset as Template, displayName: t.name }))
];

export const templateCategories = ['All', 'Minimal', 'Bold', 'Dynamic', 'Viral', 'Karaoke', 'Cinematic', 'Social', 'Meme', 'Highlight', 'Clean', 'Original'];

export function categoryOf(t: TemplateItem) {
  return t.category ?? ({
    Minimal: 'Minimal',
    'Viral Reels': 'Viral',
    Karaoke: 'Karaoke',
    WhatsApp: 'Social',
    Meme: 'Meme',
    Cinematic: 'Cinematic',
    'Glow Script': 'Highlight',
    'Ink Flow': 'Cinematic',
    'Script Duo': 'Bold',
    'Typo Stairs': 'Dynamic',
    'Kinetic Stack': 'Dynamic',
    'Hyper Clean': 'Clean',
    Editorial: 'Clean',
    'Trio Lockup': 'Bold',
    'Pop Tag': 'Highlight',
    'Neon Emerald': 'Highlight',
    'Lime Drop': 'Dynamic',
    'Amber Script': 'Cinematic',
    'Scarlet Punch': 'Bold',
    'Keyword Spotlight': 'Bold',
    'Word Wipe': 'Highlight',
    'Focus Glow': 'Highlight'
  } as Record<string, string>)[t.name] ?? 'Original';
}
