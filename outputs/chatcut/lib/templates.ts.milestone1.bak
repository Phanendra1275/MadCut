  'Minimal', 'Viral Reels', 'Karaoke', 'WhatsApp', 'Meme', 'Cinematic',
  'Glow Script', 'Ink Flow', 'Script Duo', 'Typo Stairs', 'Kinetic Stack',
  'Hyper Clean', 'Editorial', 'Trio Lockup', 'Pop Tag',
  'Left Slide', 'Right Slide', 'Up Slide', 'Down Slide',
  'Left Blur Slide', 'Right Blur Slide', 'Up Blur Slide', 'Down Blur Slide',
  'Left Bounce Slide', 'Right Bounce Slide', 'Up Bounce Slide', 'Down Bounce Slide',
  'Up Bounce Shrink', 'Down Bounce Shrink', 'Left Bounce Expand', 'Right Bounce Expand',
  'Flex Bounce', 'Gradient Blue', 'Gradient Red', 'Gradient Red Orange',
  'Jitter Shine', 'Static Shine', 'Zoom In',
  'Premium Text', 'Premium Text Without Animation',
  'Santhosham', 'Coovetica Waving of', 'Slide Collide', 'Spinning Butter',
  'Butter Up', 'cracked', 'Ocean Waves', 'Rock Solidance',
  'Neon Emerald', 'Lime Drop', 'Amber Script', 'Scarlet Punch',
  'Keyword Spotlight', 'Word Wipe', 'Focus Glow'
] as const;

export type Template = typeof templateNames[number];

export type LayoutMode = 'flow' | 'two_lines' | 'stacked' | 'single_word' | 'karaoke';
export type AnimationType = 'none' | 'pop' | 'slide' | 'bounce' | 'fade' | 'blur' | 'spring_drop' | 'wave' | 'jitter' | 'custom';
export type ColorSlot = string; // e.g. '{text}', '{accent}', or specific hex

export interface WordHighlightStyle {
  scale?: number;             // Active word scale multiplier (e.g. 1.15)
  color?: ColorSlot;          // Active word text color
  backgroundColor?: string;   // Background pill (e.g. Pop Tag)
  backgroundPadding?: { x: number; y: number };
  borderRadius?: number;
  glowBlur?: number;          // Shadow blur ratio relative to word size
  glowColor?: ColorSlot;
  wipeEffect?: boolean;       // Active word wipe clip
}

export interface TextEffectStyle {
  outlineWidth?: number;      // Stroke width ratio relative to font size (e.g. 0.1)
  outlineColor?: string;
  shadowBlur?: number;        // Shadow blur ratio relative to font size (e.g. 0.15)
  shadowColor?: ColorSlot;
  shadowOffset?: { x: number; y: number };
  gradient?: {
    direction: 'vertical' | 'horizontal';
    stops: { offset: number; color: string }[];
  };
  shimmer?: boolean;
}

export interface CaptionTemplateDefinition {
  name: Template;
  displayName?: string;
  category: string;
  label: string;
  sample: string;
  layout: {
    mode: LayoutMode;
    maxWordsPerChunk?: number;
    maxLines?: number;
    splitHalf?: boolean;       // Split evenly across 2 lines at Math.ceil(len / 2)
    verticalPositionPercent?: number;
    textAlign?: 'center' | 'left' | 'right';
    backgroundBox?: {
      color: string;
      paddingX: number;
      paddingY: number;
      borderRadius: number;
    };
  };
  typography: {
    fontPreset?: 'Auto' | 'Script' | 'Condensed' | 'Arial' | string;
    fontWeight?: string | number;
    casing?: 'uppercase' | 'none';
    sizeMultiplier?: number;
    scriptAlternate?: {
      target: 'last_word' | 'first_two' | 'second_half' | 'none';
      scale?: number;
      fontFamily?: string;
      color?: ColorSlot;
    };
  };
  colors: {
    base: ColorSlot;
    accent: ColorSlot;
    secondary?: ColorSlot;
  };
  activeWord?: WordHighlightStyle;
  effects?: TextEffectStyle;
  animation?: {
    type: AnimationType;
    direction?: [number, number]; // [x, y] unit vector
    bounce?: boolean;
    shrink?: boolean;
    expand?: boolean;
    blur?: boolean;
    durationMs?: number;
  };
}

export function resolveColor(slot: string | undefined, lookColor: string, lookAccent: string, fallback = '#ffffff'): string {
  if (!slot) return fallback;
  if (slot === '{text}' || slot === 'base') return lookColor;
  if (slot === '{accent}' || slot === 'accent') return lookAccent;
  return slot;
}

